<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSCameraUsageDescription</key>
    <string>Memindai QR Y-Connect milik motor untuk menyimpan kredensial pairing di iPhone.</string>
    <key>NSMotionUsageDescription</key>
    <string>Merekam gerakan, guncangan, tekanan udara, dan perubahan ketinggian iPhone untuk analisis perjalanan.</string>
	<!-- UIBackgroundModes butuh nilai array — INFOPLIST_KEY_UIBackgroundModes di
	     project.pbxproj TIDAK didukung mekanisme auto-generate Info.plist Xcode
	     (key ini diam-diam diabaikan, terbukti hilang total di Info.plist hasil
	     build meski build setting-nya ada). File terpisah ini di-merge oleh
	     Xcode ke Info.plist yang di-generate (GENERATE_INFOPLIST_FILE = YES
	     tetap aktif) lewat INFOPLIST_FILE — cara resmi buat key array yang
	     tidak disupport INFOPLIST_KEY_*. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
	</array>
	<!-- App ini belum dilokalisasi (hanya en), jadi tanpa key ini framework
	     sistem ikut bahasa app: instruksi belok MapKit keluar dalam bahasa
	     Inggris walau iPhone berbahasa Indonesia. Dengan key ini MapKit
	     memakai bahasa iPhone, dan suara navigasi menyesuaikan (VoicePhrases). -->
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<!-- Folder Documents (tempat file rekaman sesi) tampil di app Files ›
	     Di iPhone Saya › TelAerox — supaya rekaman bisa diakses/dibackup
	     langsung, tidak cuma lewat share sheet di dalam app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
